<?xml version="1.0" encoding="utf-8"?>
<!--
 Archivo de configuración principal de la aplicación Hospital360.
-->
<configuration>

	<!-- ========================================================= -->
	<!-- CADENAS DE CONEXIÓN -->
	<!-- ========================================================= -->
	<connectionStrings>

		<!-- Conexión a SQL Server mediante autenticación de Windows -->
		<add name="CNX_SQL"
			 providerName="System.Data.SqlClient"
			 connectionString="Data Source=.;
							   Initial Catalog=Hospital360;
							   Integrated Security=True;" />

	</connectionStrings>


	<!-- ========================================================= -->
	<!-- PROCEDIMIENTOS ALMACENADOS -->
	<!-- ========================================================= -->
	<appSettings>

		<!-- ==================== USUARIOS ==================== -->

		<!-- Inicio de sesión -->
		<add key="SP_LogIn_Usuarios"
			 value="dbo.sp_IniciarSesion" />

		<!-- Registro de usuarios -->
		<add key="SP_Insert_Usuarios"
			 value="dbo.sp_RegistrarUsuario" />

		<!-- Cierre de sesión -->
		<add key="SP_CierraSesion_Usuarios"
			 value="dbo.sp_CerrarSesion" />


		<!-- ==================== CITAS ==================== -->

		<!-- Insertar cita -->
		<add key="SP_Insert_Citas"
			 value="dbo.sp_InsertarCita" />

		<!-- Actualizar cita -->
		<add key="SP_Update_Citas"
			 value="dbo.sp_ActualizarCita" />

		<!-- Eliminar cita -->
		<add key="SP_Delete_Citas"
			 value="dbo.sp_EliminarCita" />

		<!-- Listar citas -->
		<add key="SP_Listar_Citas"
			 value="dbo.sp_ListarCitas" />

		<!-- Filtrar citas -->
		<add key="SP_Filtrar_Citas"
			 value="dbo.sp_FiltrarCitas" />

		<!-- Obtener una cita -->
		<add key="SP_Info_Cita"
			 value="dbo.sp_ObtenerCita" />


		<!-- ==================== CATÁLOGOS ==================== -->

		<!-- Profesionales -->
		<add key="SP_Listar_Profesionales"
			 value="dbo.sp_ListarProfesionales" />

		<!-- Estados de cita -->
		<add key="SP_Listar_EstadosCita"
			 value="dbo.sp_ListarEstadosCita" />

		<!-- Tipos de cita -->
		<add key="SP_Listar_TiposCita"
			 value="dbo.sp_ListarTiposCita" />

		<!-- Tipos de membresía -->
		<add key="SP_Listar_TipoMembresia"
			 value="dbo.sp_ListarTiposMembresia" />


		<!-- ==================== REPORTES ==================== -->

		<!-- Citas por estado -->
		<add key="SP_Reporte_CitasPorEstado"
			 value="dbo.sp_ReporteCitasPorEstado" />

		<!-- Citas por mes -->
		<add key="SP_Reporte_CitasPorMes"
			 value="dbo.sp_ReporteCitasPorMes" />

		<!-- Citas por tipo de atencion -->
		<add key="SP_Reporte_CitasPorTipoCita"
			 value="dbo.sp_ReporteCitasPorTipoCita" />

		<!-- Citas por profesional -->
		<add key="SP_Reporte_CitasPorProfesional"
			 value="dbo.sp_ReporteCitasPorProfesional" />

		<!-- Ingresos por mes -->
		<add key="SP_Reporte_IngresosPorMes"
			 value="dbo.sp_ReporteIngresosPorMes" />

		<!-- Citas por rango de fechas -->
		<add key="SP_Reporte_CitasPorRango"
			 value="dbo.sp_ReporteCitasPorRango" />

	</appSettings>


	<!-- ========================================================= -->
	<!-- CONFIGURACIÓN DE ASP.NET -->
	<!-- ========================================================= -->

	<system.web>

		<compilation debug="true"
					 targetFramework="4.7.2" />

		<httpRuntime targetFramework="4.7.2" />

		<globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

	</system.web>


	<!-- ========================================================= -->
	<!-- COMPILADORES -->
	<!-- ========================================================= -->

	<system.codedom>

		<compilers>

			<compiler
				language="c#;cs;csharp"
				extension=".cs"
				type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
				warningLevel="4"
				compilerOptions="/langversion:default /nowarn:1659;1699;1701" />

			<compiler
				language="vb;vbs;visualbasic;vbscript"
				extension=".vb"
				type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
				warningLevel="4"
				compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=&quot;Web&quot; /optionInfer+" />

		</compilers>

	</system.codedom>

</configuration>